# ==============================================================================
# Dhun Backend Environment Variables Example
# ==============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file or credentials to Git!

# Server Configuration
PORT=5001
NODE_ENV=development

# Database Configuration (MongoDB Atlas)
# Replace with your MongoDB connection string when ready
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/dhun?retryWrites=true&w=majority

# Google Drive OAuth Configuration
# Path to your downloaded OAuth 2.0 Desktop Client JSON file
GOOGLE_CREDENTIALS_PATH=../credentials/credentials.json

# Path where authorized access/refresh tokens will be saved locally
GOOGLE_TOKEN_PATH=../credentials/tokens.json

# OAuth Callback Port for local authorization
OAUTH_REDIRECT_PORT=3000

# Google Drive Root Folder Name for Music Library
GOOGLE_DRIVE_ROOT_FOLDER="Dhun Music Library"

# Local folder used to stage music files for import
LOCAL_IMPORT_FOLDER=../DhunMusicImport

# Authentication & Security (JWT & Admin)
JWT_SECRET=your-random-32-byte-hex-secret-for-access-tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-random-32-byte-hex-secret-for-refresh-tokens
JWT_REFRESH_EXPIRES_IN=7d
ADMIN_API_KEY=your-secure-admin-api-key-here
