{
  "name": "dhun-backend",
  "version": "1.0.0",
  "description": "Backend service for Dhun personal music app",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsx --test test/folder-organization.test.ts test/importer.test.ts test/catalog.test.ts test/auth.test.ts test/playback.test.ts test/library-sync.test.ts",
    "test:importer": "tsx test/importer.test.ts",
    "test:drive": "tsx src/scripts/testDriveConnection.ts",
    "import:dry-run": "tsx src/scripts/runDryRun.ts",
    "import:upload": "tsx src/scripts/runLiveImport.ts",
    "ingest:dry-run": "tsx src/scripts/ingestIndianTracks.ts --dry-run",
    "ingest:live": "tsx src/scripts/ingestIndianTracks.ts --yes"
  },
  "keywords": [
    "music",
    "google-drive",
    "lossless",
    "dhun"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.10.1",
    "music-metadata": "^12.3.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
